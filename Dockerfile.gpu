# GPU layer on top of the CPU image: the same toolchain, plus what TARGET=gpu
# (mim_nvptx vs iree_cuda) needs. Nothing below rebuilds LLVM or MimIR.
#
#   /opt/cuda        ptxas, fatbinary, libdevice.10.bc and the libcuda link stub
#                    (CUDA 13.0, from NVIDIA's pip wheels and apt repo; ~50 MB
#                    instead of the full toolkit). The real libcuda.so.1 and
#                    nvidia-smi come from the host driver at run time, via the
#                    NVIDIA Container Toolkit (docker run --gpus all).
#   /opt/iree-venv   torch (cpu) + iree-turbine + iree-base-{compiler,runtime}
#                    for the IREE CUDA baseline (IREE_PY).
#
# mimir-frontend and the benchmark are used as the CPU image cloned them
# (Dockerfile: FRONTEND_REPO/REF, BENCH_REPO/REF); so is the pinned llvm-link
# in /opt/llvm/bin, which the nvptx backend needs.
#
# Build:  ./build.sh  -- builds Dockerfile, then this on top of it; tag: mimir
#         (by hand: docker build -f Dockerfile.gpu --build-arg BASE_IMAGE=<cpu> .)
# Run:    ./run.sh     (docker run --gpus all -it mimir)
#         then e.g. ./run.sh --target gpu all --only "1_MLP 4_LeNet5"

# The CPU image built from ./Dockerfile (build.sh tags it this way meanwhile).
ARG BASE_IMAGE=mimir-build-cpu

# CUDA 13.0 needs a host driver >= 580 and covers sm_75 .. sm_120.
ARG NVCC_WHL_URL=https://files.pythonhosted.org/packages/71/8b/a546c12881fffeba927d810598987df25d74b8b241788c7db8dfc93b0173/nvidia_cuda_nvcc-13.0.88-py3-none-manylinux2014_x86_64.manylinux_2_17_x86_64.whl
ARG NVCC_WHL_SHA256=56fe502eb77625a12f25172caa3cdddb4e4c8ba2c8c17dba44b164761b380f03
ARG NVVM_WHL_URL=https://files.pythonhosted.org/packages/15/b0/ee41e6d1108d959b5097163e7190c2d0f7857dea75606ce358f0275891b4/nvidia_nvvm-13.0.88-py3-none-manylinux2010_x86_64.manylinux_2_12_x86_64.whl
ARG NVVM_WHL_SHA256=c5f41ffeb6466944a026dfa5317d7d85355c119bbec279205d22f1869d1054e0
ARG DRIVER_DEV_DEB_URL=https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-driver-dev-13-0_13.0.88-1_amd64.deb
ARG DRIVER_DEV_DEB_SHA256=3ffcc3fc69aa914629a97839aaf2b624508fbae9d87f187231795745a6be2550

# IREE baseline, at the versions behind the GPU results (benchmark docs/results_gpu.md).
ARG IREE_TURBINE_VERSION=3.9.0
ARG IREE_COMPILER_VERSION=3.14.0
ARG IREE_RUNTIME_VERSION=3.14.0

##############################################################################
# CUDA bits, extracted in a throwaway stage
##############################################################################
FROM ${BASE_IMAGE} AS cuda
ARG NVCC_WHL_URL
ARG NVCC_WHL_SHA256
ARG NVVM_WHL_URL
ARG NVVM_WHL_SHA256
ARG DRIVER_DEV_DEB_URL
ARG DRIVER_DEV_DEB_SHA256
USER root
WORKDIR /tmp/cuda
RUN set -eu \
 && curl -fsSL -o nvcc.whl "$NVCC_WHL_URL" \
 && curl -fsSL -o nvvm.whl "$NVVM_WHL_URL" \
 && curl -fsSL -o driver-dev.deb "$DRIVER_DEV_DEB_URL" \
 && printf '%s  %s\n' "$NVCC_WHL_SHA256" nvcc.whl "$NVVM_WHL_SHA256" nvvm.whl "$DRIVER_DEV_DEB_SHA256" driver-dev.deb \
      | sha256sum -c - \
 && bsdtar -xf nvcc.whl nvidia/cu13/bin/ptxas nvidia/cu13/bin/fatbinary \
 && bsdtar -xf nvvm.whl nvidia/cu13/nvvm/libdevice/libdevice.10.bc \
 && bsdtar -xOf driver-dev.deb 'data.tar*' | bsdtar -xf - ./usr/local/cuda-13.0/targets/x86_64-linux/lib/stubs/libcuda.so \
 && install -Dm755 nvidia/cu13/bin/ptxas     /opt/cuda/bin/ptxas \
 && install -Dm755 nvidia/cu13/bin/fatbinary /opt/cuda/bin/fatbinary \
 && install -Dm644 nvidia/cu13/nvvm/libdevice/libdevice.10.bc /opt/cuda/nvvm/libdevice/libdevice.10.bc \
 && install -Dm755 usr/local/cuda-13.0/targets/x86_64-linux/lib/stubs/libcuda.so /opt/cuda/lib64/stubs/libcuda.so \
 && /opt/cuda/bin/ptxas --version | tail -2

##############################################################################
# GPU image
##############################################################################
FROM ${BASE_IMAGE}
ARG IREE_TURBINE_VERSION
ARG IREE_COMPILER_VERSION
ARG IREE_RUNTIME_VERSION
ARG TORCH_VERSION=2.14.0

USER root
COPY --from=cuda /opt/cuda /opt/cuda

# A separate venv, so torch-mlir's /opt/torch-venv stays exactly as built.
# uv searches --extra-index-url before --index-url, so the +cpu torch wheel
# (only on download.pytorch.org) is found there; IREE comes from PyPI.
RUN uv venv -q --python /opt/python/cpython-3.12.12-linux-x86_64-gnu/bin/python3.12 /opt/iree-venv \
 && uv pip install -q --no-cache --python /opt/iree-venv/bin/python \
      --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cpu \
      "torch==${TORCH_VERSION}+cpu" numpy \
      "iree-turbine==${IREE_TURBINE_VERSION}" \
      "iree-base-compiler==${IREE_COMPILER_VERSION}" \
      "iree-base-runtime==${IREE_RUNTIME_VERSION}" \
 && /opt/iree-venv/bin/python -c "import torch, iree.turbine, iree.runtime as rt; print('iree-venv: torch', torch.__version__, '| HAL drivers', rt.query_available_drivers())" \
 && /opt/iree-venv/bin/iree-compile --iree-hal-list-target-backends | grep -qw cuda \
 && /opt/iree-venv/bin/iree-compile --version | head -1

ENV CUDA_HOME=/opt/cuda \
    PATH=/opt/cuda/bin:$PATH \
    IREE_PY=/opt/iree-venv/bin/python \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

USER bench
WORKDIR /home/bench

# Compile-only check (no GPU at build time): a model must come out as a host
# .ll with an embedded fatbin. nvptx.emit only warns when a tool is missing and
# writes a placeholder instead, so test for that explicitly. Loading the JIT .so
# needs a libcuda.so.1: the stub stands in for this RUN only (never as ENV, it
# would shadow the driver's libcuda that `docker run --gpus` injects).
ARG GPU_CHECK_SM=86
RUN test -x /opt/llvm/bin/llvm-link || { echo "base image lacks /opt/llvm/bin/llvm-link: rebuild it with ./build.sh" >&2; exit 1; } \
 && mkdir -p /tmp/cudastub && ln -s /opt/cuda/lib64/stubs/libcuda.so /tmp/cudastub/libcuda.so.1 \
 && cd /home/bench/mimir-frontend \
 && LD_LIBRARY_PATH=/tmp/cudastub MIMIR_GPU_SM=${GPU_CHECK_SM} uv run --no-sync python - <<'EOF'
import pathlib, tempfile, torch
from mimir_frontend.backend import mimir_backend
out = pathlib.Path(tempfile.mkdtemp())
def capture(gm, xs):
    mimir_backend(gm, xs, options={"target": "nvptx", "debug_dir": str(out), "cache": False})
    return gm.forward
m = torch.nn.Sequential(torch.nn.Linear(16, 8), torch.nn.GELU(), torch.nn.Linear(8, 4)).eval()
with torch.no_grad():
    torch.compile(m, backend=capture, fullgraph=True)(torch.randn(2, 16))
host = [p for p in out.glob("mimir_graph_*.ll") if not p.name.endswith("_dev.ll")]
assert len(host) == 1 and list(out.glob("*.so")), sorted(p.name for p in out.iterdir())
text = host[0].read_text()
assert "@.fatbin = private constant" in text and "YOUR_FATBIN" not in text, "fatbin not embedded"
print("nvptx toolchain ok:", host[0].name, f"{len(text)} bytes")
EOF

WORKDIR /home/bench/benchmark

CMD ["/bin/bash", "-c", "cat <<'EOF'\n\
KernelBench level-3 on NVIDIA GPUs: MimIR (nvptx) vs IREE (cuda) -- started with --gpus all?\n\
\n\
  nvidia-smi                        the GPU the benchmark will use\n\
  ./run.sh --target gpu all         the GPU pipeline (TARGET=cpu|gpu|both)\n\
  ./run.sh                          the CPU pipeline still works as in the cpu image\n\
\n\
See README.md.\n\
EOF\n\
exec /bin/bash"]
